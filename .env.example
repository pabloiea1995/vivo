# ─── Secretos del servidor ───────────────────────────────────────────────────
# Van en las Environment Variables del proyecto de Vercel (y en un .env local,
# que está en .gitignore). Ninguna llega al navegador: la página solo habla con
# /api/*, y las claves de proveedor se quedan en las funciones.

# Visión (propuesta de modos) y moderación. Sin ella la app sigue funcionando:
# /api/suggest cae al catálogo fijo de modos y no hay moderación (falla abierto).
OPENAI_API_KEY=sk-...

# fal.ai — el modelo de vídeo. REQUERIDA: sin ella no hay clip que enseñar.
FALAI_TOKEN=...

# Firma de los tickets de modo (mínimo 16 caracteres). Opcional pero
# recomendada: sin ella cada instancia serverless firma con un secreto efímero
# propio, así que un ticket emitido por una instancia no verifica en otra y el
# usuario ve "Ese modo ha caducado" de forma aleatoria.
VIVO_TICKET_SECRET=

# La cerradura del backend. Sin ella, /api/suggest y /api/video están abiertos a
# quien encuentre la URL — y /api/video gasta dinero en cada llamada. En cuanto
# se pone, toda petición debe traer la misma cadena en la cabecera `x-vivo-key`
# (a la página se le pasa una vez por la URL: …/?key=…, y la recuerda).
# VIVO_APP_SECRET=

# ─── Ajustes opcionales ──────────────────────────────────────────────────────
# Modelo de visión. Por defecto gpt-5.6-luna. Solo acepta modelos con tarifa en
# api/_pricing.ts: uno que no sabemos tarifar es uno que no sabemos medir.
# VIVO_VISION_MODEL=gpt-5-mini
# Cuánto se espera a la visión antes de caer al catálogo (ms).
# VIVO_VISION_TIMEOUT_MS=8000
# Fuerza el tramo de tarifa de fal cuando cambien el descuento de lanzamiento.
# VIVO_FAL_PROMO=on
# Orígenes de navegador extra permitidos, separados por comas.
# VIVO_ALLOWED_ORIGINS=https://mi-preview.vercel.app
# Cambio USD→EUR para el coste que se enseña en pantalla (por defecto 0.92).
# VIVO_USD_EUR=0.92

# El cliente no necesita ninguna variable: la página se sirve desde el mismo
# origen que la API. La cerradura se le pasa una vez por la URL
# (…/?key=<VIVO_APP_SECRET>) y el navegador la recuerda.
